NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Core secrets. Replace all placeholders before production.
MONGODB_URI=mongodb://localhost:27017/psevent
JWT_SECRET=replace-with-long-random-secret
SESSION_TOKEN_HASH_SECRET=replace-with-different-long-random-secret
CSRF_SECRET=replace-with-csrf-secret
BCRYPT_SALT_ROUNDS=12

# Production secret provider. Keep disabled for local development.
SECRET_PROVIDER=env
SECRET_MANAGER_ENABLED=false
SECRET_MANAGER_PROJECT_ID=
SECRET_MANAGER_PREFIX=psevent/dev
SECRET_MANAGER_CACHE_TTL_MS=300000
SECRET_MANAGER_MAX_DAILY_ACCESS_OPS=200
SECRET_MANAGER_FAIL_CLOSED=true
SECRET_MANAGER_REQUIRE_PINNED_VERSIONS=true
SECRET_MANAGER_SECRET_IDS_JSON={}
SECRET_MANAGER_PINNED_VERSIONS_JSON={}
SECRET_MANAGER_LOAD_NAMES=
SECRET_TEST_FILE=
RUNTIME_SECRET_VALIDATION_STRICT=false

# Admin session policy
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_REFRESH_THRESHOLD=5m
SESSION_PREVIOUS_TOKEN_GRACE=30s
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Participant session and OTP policy
PARTICIPANT_EMAIL_LOGIN_ENABLED=true
PARTICIPANT_JWT_EXPIRES_IN=7d
PARTICIPANT_SESSION_TTL=7d
PARTICIPANT_SESSION_ABSOLUTE_TIMEOUT=30d
PARTICIPANT_SESSION_PREVIOUS_TOKEN_GRACE=30s
PARTICIPANT_MAX_ACTIVE_SESSIONS=5
PARTICIPANT_REQUIRE_SESSION_STORE=true
PARTICIPANT_AUTH_OTP_TTL_MS=600000
PARTICIPANT_STEP_UP_EXPIRES_IN=10m
ALLOW_LEGACY_CERTIFICATE_PARTICIPANT_ID=false

# Google login
LOGIN_CLIENT_ID=replace-with-google-oauth-client-id

# Scheduled PDF report upload to Google Drive
GOOGLE_DRIVE_ENABLED=false
REPORT_SCHEDULER_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Bot protection
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
PUBLIC_REPORT_MAX_ROWS=100
PUBLIC_AGGREGATE_MIN_GROUP_SIZE=3

# Email
MOCK_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PSEvent <noreply@example.com>"

# LINE Login / LIFF / OA
LINE_LOGIN_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:5173/user/line/callback
LINE_LOGIN_CALLBACK_URLS=http://localhost:5173/user/line/callback
LINE_LOGIN_SCOPE=profile openid email
LINE_WEBHOOK_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
LINE_ALLOW_LEGACY_USER_ID_LOGIN=false
LINE_WEBHOOK_ENABLED=false
LINE_MESSAGING_ENABLED=false

# Wallet, vendor QR, and payment slip proof
VENDOR_QR_SECRET=replace-with-vendor-qr-signing-secret
SLIP_PROOF_SECRET=replace-with-slip-proof-secret
SUCCESS_SLIP_TTL_SECONDS=180

# Field encryption. DATA_ENCRYPTION_KEYS is a JSON object such as {"v1":"base64url-32-byte-key"}.
FIELD_ENCRYPTION_ENABLED=false
E2EE_STRICT_MODE=false
FIELD_ENCRYPTION_SECRET_NAME=DATA_ENCRYPTION_KEYS
DATA_ENCRYPTION_KEY_ID=v1
DATA_ENCRYPTION_KEYS=
DATA_BLIND_INDEX_SECRET=replace-with-blind-index-secret
SENSITIVE_AUDIT_STRICT=false

# Optional Google Cloud KMS data-key bootstrap
KMS_DATA_KEY_ENABLED=false
KMS_KEY_RESOURCE=projects/example/locations/asia-southeast1/keyRings/psevent/cryptoKeys/field-data-key
KMS_WRAPPED_DATA_KEYS=
KMS_DATA_KEY_CACHE_TTL_MS=300000

# Optional Firestore mirror for payment status. MongoDB remains the source of truth.
FIRESTORE_MIRROR_ENABLED=false
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_PAYMENT_STATUS_COLLECTION=paymentStatus
FIRESTORE_PAYMENT_STATUS_TTL_HOURS=24

# Optional structured SQL mirror / future primary store. Do not enable in production before migration validation.
SQL_ENABLED=false
SQL_DIALECT=mariadb
SQL_PRIMARY_STORE=false
SQL_HOST=127.0.0.1
SQL_PORT=3306
SQL_SOCKET_PATH=
SQL_DATABASE=psevent
SQL_USER=psevent_app
SQL_PASSWORD=replace-with-sql-password-or-secret-manager-ref
SQL_MIGRATION_USER=psevent_migration
SQL_MIGRATION_PASSWORD=replace-with-separate-migration-password
SQL_MIGRATION_ALLOW_RUNTIME_CREDENTIALS=false
SQL_SSL_MODE=disabled
SQL_SSL_CA=
SQL_SSL_CA_SECRET_NAME=
SQL_ALLOW_INSECURE_PRODUCTION=false
SQL_ALLOW_UNVERIFIED_TLS=false
SQL_POOL_MIN=0
SQL_POOL_MAX=5
SQL_POOL_IDLE_TIMEOUT_MS=60000
SQL_QUEUE_LIMIT=100
SQL_CONNECT_TIMEOUT_MS=5000
SQL_QUERY_TIMEOUT_MS=10000
SQL_PRIMARY_STORE_ACKNOWLEDGED=false
SQL_MIGRATION_WRITE=false
SQL_MIGRATION_LOCK_TIMEOUT_SECONDS=15
SQL_MIRROR_ENABLED=false
SQL_MIRROR_IDENTITY_HASH_SECRET=replace-with-dedicated-identity-hash-secret
SQL_BACKFILL_WRITE=false
SQL_OUTBOX_ENABLED=false
SQL_OUTBOX_STRICT=false
SQL_OUTBOX_POLL_INTERVAL_MS=5000
SQL_OUTBOX_BATCH_SIZE=25
SQL_OUTBOX_MAX_ATTEMPTS=8
SQL_OUTBOX_LOCK_TIMEOUT_MS=120000
SQL_OUTBOX_BASE_RETRY_MS=1000
SQL_OUTBOX_MAX_RETRY_MS=300000
SQL_OUTBOX_COMPLETED_RETENTION_DAYS=7
SQL_OUTBOX_MAX_ENQUEUE_PER_WRITE=1000
SQL_OUTBOX_REPLAY=false
SQL_MAX_SYNC_LAG_SECONDS=60
SQL_WALLET_LEDGER_ENABLED=false
SQL_RECEIPT_COUNTER_ENABLED=false

# MongoDB pool/readiness
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=20
SERVER_SHUTDOWN_TIMEOUT_MS=10000

# Image/object storage. Use local in development and a private GCS bucket in production.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_PUBLIC_API_ORIGIN=http://localhost:3000
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_LOCAL_SIGNING_SECRET=replace-with-dedicated-long-random-secret
# Keep true only while legacy files are being migrated. The production default becomes false with GCS.
LEGACY_UPLOADS_PUBLIC_ENABLED=true

GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
GCS_LOCATION=asia-southeast3
GCS_OBJECT_PREFIX=psevent/development
GCS_VALIDATE_BUCKET_ON_STARTUP=true
GCS_REQUIRE_LIFECYCLE=true
GCS_REJECT_CONFLICTING_LIFECYCLE=true
GCS_REQUIRE_LEGACY_UPLOADS_DISABLED=true
GCS_REQUIRE_SINGLE_REGION=true
GCS_PRIVATE_SIGNED_URL_TTL_SECONDS=300
GCS_PUBLIC_SIGNED_URL_TTL_SECONDS=3600
GCS_UNLINKED_UPLOAD_TTL_HOURS=24
GCS_SLIP_RETENTION_DAYS=365
GCS_LIFECYCLE_DELETE_GRACE_DAYS=2
GCS_REQUIRE_STANDARD_STORAGE=true
GCS_REQUIRE_VERSIONING_DISABLED=true
GCS_REQUIRE_AUTOCLASS_DISABLED=true
GCS_REQUIRE_FLAT_NAMESPACE=true
GCS_MAX_SOFT_DELETE_RETENTION_DAYS=7
GCS_MAX_BUCKET_RETENTION_DAYS=0
GCS_REQUIRE_DEFAULT_EVENT_HOLD_DISABLED=true
EVENT_MEDIA_ALLOW_EXTERNAL_URLS=false
OBJECT_STORAGE_CLEANUP_SCHEDULER_ENABLED=true
OBJECT_STORAGE_CLEANUP_WRITE=false
OBJECT_STORAGE_MIGRATION_WRITE=false
GCS_BUCKET_CONFIG_WRITE=false

# Require a replay-safe key for Donation create in production.
DONATION_IDEMPOTENCY_REQUIRED=true
PARTICIPANT_REGISTRATION_IDEMPOTENCY_REQUIRED=true

# GCS cost model and per-process safety limits. Egress is the main cost driver.
GCS_MONTHLY_BUDGET_THB=700
GCS_COST_USD_TO_THB=33.5
GCS_COST_STANDARD_STORAGE_USD_PER_GIB_MONTH=0.02
GCS_COST_CLASS_A_USD_PER_THOUSAND=0.005
GCS_COST_CLASS_B_USD_PER_THOUSAND=0.0004
GCS_COST_INTERNET_EGRESS_USD_PER_GIB=0.12
GCS_EXPECTED_MONTHLY_UPLOADS=0
GCS_EXPECTED_MONTHLY_DOWNLOADS=0
GCS_EXPECTED_MONTHLY_EGRESS_GIB=0
GCS_MAX_DAILY_UPLOADS=1000
GCS_MAX_DAILY_UPLOAD_KIB=1048576
GCS_MAX_DAILY_PROJECTED_EGRESS_KIB=4194304
GCS_MAX_DAILY_SIGNED_URL_OPS=10000
GCS_MAX_DAILY_METADATA_OPS=10000

# Google Cloud cost guardrails. Defaults target <= 1,000 THB/month under normal load.
GOOGLE_CLOUD_OPTIONAL_FEATURES_ENABLED=true
GOOGLE_CLOUD_MONTHLY_BUDGET_THB=1000
CLOUD_COST_TIMEZONE=Asia/Bangkok
KMS_MAX_DAILY_CRYPTO_OPS=500
FIRESTORE_MAX_DAILY_READS=10000
FIRESTORE_MAX_DAILY_WRITES=3000
FIRESTORE_MAX_DAILY_DELETES=1000
SQL_MAX_DAILY_WRITES=5000
SQL_MAX_DAILY_READS=20000

# Upload/report/public cache
AUDIT_LOG_RETENTION_DAYS=365
PUBLIC_CACHE_TTL_MS=30000

# Migration safety flags. Keep write flags false unless running a planned migration.
DRY_RUN=true
GUEST_TOKEN_MIGRATION_WRITE=false
GUEST_TOKEN_UNSET_PLAINTEXT=false
PARTICIPANT_FIELD_SCOPE_WRITE=false
PARTICIPANT_FIELD_ASSIGN_CURRENT_EVENT=false
PARTICIPANT_FIELD_DROP_NAME_INDEX=false
PARTICIPANT_POINT_MIGRATION_WRITE=false
CERTIFICATE_VERIFICATION_MIGRATION_WRITE=false
REG_POINT_SCOPE_WRITE=false
REG_POINT_ASSIGN_CURRENT_EVENT=false
REG_POINT_DROP_NAME_INDEX=false
