# Non-secret deployment configuration. Production overrides belong in GitHub environment variables.
REGION=asia-southeast3
SERVICE=psevent-production
ARTIFACT_REPOSITORY=psevent
RUNTIME_SERVICE_ACCOUNT=psevent-runtime-production
MIGRATION_SERVICE_ACCOUNT=psevent-migration-production
DEPLOYER_SERVICE_ACCOUNT=psevent-deployer-production
SECRET_MANAGER_PREFIX=psevent-production

CPU=1
MEMORY=1Gi
MIN_INSTANCES=0
MAX_INSTANCES=3
CONCURRENCY=40
REQUEST_TIMEOUT=300s
PUBLIC_SERVICE=true

PARTICIPANT_EMAIL_LOGIN_ENABLED=true
MOCK_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=

FIELD_ENCRYPTION_ENABLED=true
FIELD_ENCRYPTION_SECRET_NAME=DATA_ENCRYPTION_KEY
DATA_ENCRYPTION_KEY_ID=v1
E2EE_STRICT_MODE=false
KMS_DATA_KEY_ENABLED=false
FIRESTORE_MIRROR_ENABLED=false

SQL_ENABLED=false
SQL_PRIMARY_STORE=false
SQL_MIRROR_ENABLED=false
SQL_OUTBOX_ENABLED=false
RUN_SQL_MIGRATIONS=false

OBJECT_STORAGE_PROVIDER=gcs
GCS_LOCATION=asia-southeast3
GCS_OBJECT_PREFIX=psevent/production
GCS_SLIP_RETENTION_DAYS=365
GCS_UNLINKED_UPLOAD_TTL_HOURS=24
GCS_LIFECYCLE_DELETE_GRACE_DAYS=2

GOOGLE_CLOUD_MONTHLY_BUDGET_THB=1000
GCS_MONTHLY_BUDGET_THB=700
GOOGLE_CLOUD_OPTIONAL_FEATURES_ENABLED=true
REPORT_SCHEDULER_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
LINE_LOGIN_ENABLED=false
LINE_WEBHOOK_ENABLED=false
LINE_MESSAGING_ENABLED=false
