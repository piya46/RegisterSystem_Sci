# Configure these in Plesk Node.js. Plesk injects PORT automatically.
NODE_ENV=production
PUBLIC_HOST=reunion.scicu-alumni.com
UPSTREAM_ORIGIN=https://psevent-staging-841769493273.asia-southeast3.run.app
UPSTREAM_TIMEOUT_MS=30000

# Public build-time values used by the Plesk Git additional deployment action.
VITE_CF_TURNSTILE_SITE_KEY=replace-with-public-site-key
VITE_GOOGLE_CLIENT_ID=
VITE_LIFF_ID=
